{
  "name": "@nuup/ts-rosa",
  "version": "0.1.6",
  "description": "A modern TypeScript XForms engine — behavior-compatible reimplementation of JavaRosa.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuupco/ts-rosa"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src/"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.0",
    "crypto-js": "^4.2.0",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-plugin-n": "^18.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
